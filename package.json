{
  "name": "netuno-crm-widgets",
  "version": "0.15.1",
  "private": true,
  "description": "Widgets de Netuno para Zoho CRM: un solo proyecto, una sola versión, un módulo por widget",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:zoho": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --mode produccion",
    "build:pruebas": "tsc -b && vite build --mode pruebas",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "deploy:pruebas": "node tooling/desplegar.mjs pruebas",
    "deploy:produccion": "node tooling/desplegar.mjs produccion",
    "empaquetar:pruebas": "node tooling/empaquetar.mjs pruebas",
    "empaquetar:produccion": "node tooling/empaquetar.mjs produccion"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "dompurify": "^3.4.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fflate": "^0.8.3",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}

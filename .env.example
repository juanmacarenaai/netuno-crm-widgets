# Copia este archivo como .env.local (no se versiona) y completa los valores.
#
# ⚠️ Todo lo que empieza con VITE_ queda dentro del código que se envía al navegador,
# igual que hoy en los widgets jQuery. Es temporal: la fase de seguridad mueve estas
# credenciales a Catalyst o a una conexión de Zoho (ver docs/arquitectura.md).

# Credenciales de la API de Netuno (cabeceras client_id / client_secret)
VITE_NETUNO_CLIENT_ID=
VITE_NETUNO_CLIENT_SECRET=

# Solo si Traslado usa Weezie en modo "api" (src/modulos/unidad-comercial/traslado/config.ts → fuente).
# Credenciales y ambiente de Weezie pendientes de confirmar.
VITE_ZCFKEY_WEEZIE=

# Funciones de Catalyst del proyecto "crm" (territorios, fallas masivas PEM/TEM, subir archivos).
# Es la cabecera ZCFKEY que el widget jQuery llama ZCFKEY_Consulta_PEM.
VITE_ZCFKEY_CATALYST=

# Registro de conexiones de Catalyst (proyecto "connectionlog"; Historial). Vacío = no se registra.
VITE_ZCFKEY_CONNECTIONLOG=

# Troubleshooting: reporte de fallas a node-red (posibles eventos masivos). En el widget jQuery:
# user / password (Basic) y authorization_url_registro_PEM.
VITE_PEM_USUARIO=
VITE_PEM_CLAVE=
VITE_PEM_TOKEN=

# Opcional: fuerza el entorno sin importar el modo del build ("pruebas" o "produccion").
# Úsalo solo para una prueba puntual; lo normal es elegirlo con el script (build / build:pruebas).
# VITE_ENTORNO=
